# TopStepX credentials
# Get your API key from: TopStepX dashboard > API Access
TOPSTEP_USER=your_topstep_username
TOPSTEP_API_KEY=your_api_key

# Environment: "demo" for paper trading, "live" for real funded account
TOPSTEP_ENV=demo

# Telegram Alerts (optional) — get trade notifications on your phone
# 1. Open Telegram, search @BotFather, send /newbot, copy the token
# 2. Search @userinfobot, send /start, copy your chat ID
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Live Hub (optional) — set these to report trades to your dashboard
# HUB_URL=http://your-server-ip:9090
# HUB_USER_ID=friend1
